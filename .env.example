# ==============================================================================
# Orvix Sphere — Environment Configuration Template
# ==============================================================================
# Copy this file to `.env` and fill in your configuration:
#   copy .env.example .env     (Windows Command Prompt)
#   cp .env.example .env       (Linux / macOS / PowerShell)
# ==============================================================================

# --- System & Web Server Configuration ---
ORVIX_ENV=production
ORVIX_LOG_LEVEL=INFO
ORVIX_WEB_HOST=127.0.0.1
ORVIX_WEB_PORT=8000

# --- Primary Cognitive Cloud AI (Google Gemini) ---
# Get your free Gemini API key at: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here

# Default Gemini model (e.g. gemini-2.0-flash, gemini-1.5-flash)
GEMINI_MODEL=gemini-2.0-flash

# Model Routing Mode:
#   - cloud_first : Use Gemini Cloud API; fallback to local model if offline/rate-limited (Recommended)
#   - auto        : Intelligently routes between cloud and local based on availability
#   - cloud_only  : Exclusively use Gemini Cloud API
#   - local_only  : Exclusively use local model (Ollama / offline weights)
MODEL_MODE=cloud_first

# Fallback & Resilience Settings
FALLBACK_ENABLED=true
GEMINI_MAX_RETRIES=3
RATE_LIMIT_RPM=14
COST_TRACKING=true
GEMINI_TIMEOUT_SEC=30.0

# --- Local AI Engine & Ollama Configuration (Optional / Offline) ---
# Used for offline fallback or when MODEL_MODE=local_first / local_only
OLLAMA_HOST=http://127.0.0.1:11434
LLAMA_MODEL=models/llama
LLAMA_PROVIDER=local_transformers
LLAMA_DEVICE=cpu

# --- Model Context Protocol (MCP) & Tool Permissions ---
NODE_ENV=production
# Directory permitted for MCP filesystem access (defaults to user's Documents folder)
# ALLOWED_DOCS_DIR=~/Documents

# --- Storage & Backup Settings ---
# Custom backup directory (defaults to <project_root>/backups or W:/PHASS_MEMORY/backups if available)
# BACKUP_DIR=./backups
